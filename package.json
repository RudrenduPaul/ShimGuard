{
  "name": "shimguard-cli",
  "version": "0.1.7",
  "description": "Verify that a GitHub issue closed as \"fixed\" actually has a merged fix. Catches security issues and bugs marked fixed whose PR was never merged, with structured JSON output for CI and AI agents.",
  "keywords": [
    "security",
    "cli",
    "github",
    "issue-tracker",
    "verification",
    "supply-chain",
    "vulnerability-scanner",
    "agent-native",
    "devsecops",
    "pull-request"
  ],
  "homepage": "https://github.com/RudrenduPaul/ShimGuard#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/ShimGuard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/ShimGuard.git"
  },
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "type": "module",
  "bin": {
    "shimguard": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23"
  }
}
